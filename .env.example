HOST=0.0.0.0
PORT=8790
NODE_ENV=development
# Neon: Connect -> turn OFF Connection pooling -> copy your connection string.
# Paste only the URL, without the surrounding psql command. Keep it private.
DATABASE_URL="postgresql://neondb_owner:REPLACE_ME@ep-YOUR-ENDPOINT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_SSL=true
# For local PostgreSQL instead, use a local URL and DATABASE_SSL=false:
# DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/gfamily_frozen_system
DB_POOL_SIZE=5
# Exact frontend origin, no trailing slash. Comma-separated origins supported.
FRONTEND_URL=http://localhost:8790
# Required by the Render blueprint; enter this token only for first-owner setup.
OWNER_SETUP_TOKEN=
# Vercel only: the public HTTPS origin of the Render service (no /api suffix).
BACKEND_URL=
