{
  "name": "gfamily-frozen-system",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && node --watch server.js",
    "dev:local": "powershell -ExecutionPolicy Bypass -File ./start-local.ps1",
    "build": "npm run build:css && node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "check": "npm test && npm run build",
    "db:backup": "node scripts/backup.mjs",
    "build:css": "tailwindcss -i styles/app.css -o style.css --minify"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5"
  }
}
